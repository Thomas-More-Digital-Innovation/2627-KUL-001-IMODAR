# Copy to .env (git-ignored) and fill in.
DATABASE_URL=postgresql+psycopg://imodar:imodar@localhost:5432/imodar
IMODAR_WAREHOUSE=
OLLAMA_URL=http://localhost:11434

# Encrypts 2FA secrets; losing it makes every enrolled authenticator unusable.
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# First admin, created by: uv run python -m imodar.auth.seed_admin
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Set to false only for plain-HTTP development in browsers that reject Secure cookies on localhost.
COOKIE_SECURE=true
